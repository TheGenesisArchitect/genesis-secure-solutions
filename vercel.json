{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/outbox",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/mercury",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/scan",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/studio",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/court",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/autopilot",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/competitors",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/posts",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/visibility",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/leads",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "app/api/studio/unedit/[id]/step/route.ts": {
      "memory": 3009
    },
    "app/api/studio/unedit/[id]/part/[k]/route.ts": {
      "memory": 3009
    }
  }
}
