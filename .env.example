# Created when the Vercel Blob store is connected to this project. Server-only.
BLOB_READ_WRITE_TOKEN=

# Optional, server-only. Shown in the social guide once set; until then the guide says "we give it to you on the call".
# Genesis Secure Solutions' Meta business portfolio ID (digits only) and the email clients invite as a Google Business Profile manager.
# Never use a genesisbanking.io address here.
GSS_META_BUSINESS_ID=
GSS_GOOGLE_INVITE_EMAIL=

# Server-only. The operator console password (any username). At least 16 characters; the console answers 503 until it is set.
GSS_CONSOLE_PASSWORD=

# Meta connector (server-only). From the Meta app and our business portfolio; see /console/meta.
META_APP_ID=
META_APP_SECRET=
# Token for a system user in our own portfolio (our Page and Instagram only).
META_SYSTEM_USER_TOKEN=
# The string typed into the App Dashboard webhook Verify Token field; local copy in .meta-webhook.local
META_WEBHOOK_VERIFY_TOKEN=
